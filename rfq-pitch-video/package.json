{
  "name": "rfq-pitch-video",
  "version": "1.0.0",
  "private": true,
  "description": "30-second explainer: RFQ replies to import-ready spreadsheets, rendered with Remotion",
  "scripts": {
    "voice": "python3 scripts/make_audio.py",
    "studio": "remotion studio src/index.ts",
    "render": "node scripts/render.mjs",
    "build": "npm run voice && npm run render",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@fontsource/inter": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@remotion/bundler": "^4.0.535",
    "@remotion/cli": "^4.0.535",
    "@remotion/renderer": "^4.0.535",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "remotion": "^4.0.535"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "typescript": "^7.0.2"
  }
}
