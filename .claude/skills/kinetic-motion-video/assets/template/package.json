{
  "name": "kinetic-video",
  "version": "1.0.0",
  "private": true,
  "description": "Kinetic motion explainer rendered with Remotion, synced to a measured voice-over",
  "scripts": {
    "voice": "python3 scripts/make_audio.py",
    "studio": "remotion studio src/index.ts",
    "stills": "node scripts/stills.mjs",
    "render": "node scripts/render.mjs",
    "build": "npm run voice && npm run render",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@fontsource/inter": "^5.2.0",
    "@fontsource/jetbrains-mono": "^5.2.0",
    "@remotion/bundler": "4.0.535",
    "@remotion/cli": "4.0.535",
    "@remotion/renderer": "4.0.535",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "remotion": "4.0.535"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "typescript": "^5.6.0"
  }
}
